# Local development only. Never put real credentials in this file.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shortlink
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=replace-this-local-value-before-sharing
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Configure SMTP to enable signup and email verification locally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ShortLink <no-reply@example.com>"

# Optional in development; production URL checks fail closed without this key.
SAFE_BROWSING_API_KEY=

# Non-secret placeholders let the Razorpay SDK initialize locally. Replace
# them with Razorpay Test Mode credentials to exercise billing flows.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_PLAN_ID=plan_replace_me
RAZORPAY_WEBHOOK_SECRET=replace_with_test_webhook_secret
